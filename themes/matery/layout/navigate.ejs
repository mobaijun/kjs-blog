width:31.333%;margin:1%}.link-3{display:block;background:rgba(0,0,0,.35);color:#FFF;font-size:13px;text-align:center;line-height:35px;padding:4px 0;border-radius:2px;transition:all .2s}.link-3:hover{background:rgba(0,0,0,.45);font-size:15px;font-weight:bold}@media only screen and (max-width:601px){.navi-height{height:95%}.link-box{margin-top:12%}.large-screen{display:none}}@media only screen and (min-width:600px) and (max-width:993px){.navi-height{height:100%}.link-box{margin-top:5%}.large-screen{display:none}}@media only screen and (min-width:993px){.navi-height{position:absolute;width:100%;height:100%}}.page-footer{display:none}

    .search-bar-container {
        width: 100%;
        display: flex;
        justify-content: center;
        margin: 48px 0 36px 0;
    }

    .search-bar-inner {
        display: flex;
        align-items: center;
        background: #fff;
        border-radius: 24px;
        box-shadow: 0 1px 6px 0 rgba(32, 33, 36, 0.28);
        padding: 0 8px 0 0;
        width: 560px;
        max-width: 98vw;
        position: relative;
        border: 1px solid #dfe1e5;
        height: 44px;
        transition: box-shadow 0.25s, border 0.25s;
    }

    .search-bar-inner:focus-within {
        box-shadow: 0 1px 6px 0 rgba(32, 33, 36, 0.28), 0 0 0 2px #1a73e8;
        border: 2px solid #1a73e8;
    }

    .search-engine-selector {
        display: flex;
        align-items: center;
        cursor: pointer;
        border-radius: 24px 0 0 24px;
        padding: 0 16px 0 16px;
        height: 44px;
        position: relative;
        user-select: none;
        background: transparent;
        transition: background 0.2s;
    }

    .search-engine-selector:hover {
        background: #f5f7fa;
    }

    .search-engine-selector img {
        width: 20px;
        height: 20px;
        margin-right: 7px;
    }

    .search-engine-selector .chevron {
        margin-left: 7px;
        transition: transform 0.2s;
    }

    .search-engine-selector.open .chevron {
        transform: rotate(180deg);
    }

    .engine-list {
        display: none;
        position: absolute;
        top: 48px;
        left: 0;
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 24px 0 rgba(60, 64, 67, 0.13);
        z-index: 10;
        min-width: 120px;
        padding: 6px 0;
        animation: fadeIn 0.18s;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-8px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .engine-list li {
        padding: 9px 18px;
        cursor: pointer;
        display: flex;
        align-items: center;
        font-size: 15px;
        color: #222;
        font-weight: 500;
        background: #fff;
        border-bottom: 1px solid #f1f3f4;
        opacity: 1 !important;
    }

    .engine-list li:last-child {
        border-bottom: none;
    }

    .engine-list li img {
        width: 18px;
        height: 18px;
        margin-right: 8px;
    }

    .engine-list li:hover {
        background: #f1f3f4;
        color: #1a73e8;
    }

    .search-engine-selector.open .engine-list {
        display: block;
    }

    #search-input {
        border: none !important;
        outline: none !important;
        font-size: 16px;
        flex: 1;
        background: transparent;
        padding: 0 8px;
        color: #222;
        min-width: 0;
        height: 44px;
        line-height: 44px;
        box-shadow: none !important;
    }

    #search-input:focus {
        border: none !important;
        outline: none !important;
        box-shadow: none !important;
    }

    #search-input::placeholder {
        color: #bbb;
        font-size: 16px;
        line-height: 44px;
    }

    .search-btn {
        display: flex;
        align-items: center;
        background: #1a73e8;
        color: #fff;
        border: none;
        border-radius: 18px;
        padding: 0 18px 0 12px;
        font-size: 15px;
        margin-left: 8px;
        cursor: pointer;
        transition: background 0.2s, box-shadow 0.2s;
        box-shadow: 0 2px 8px rgba(26, 115, 232, 0.08);
        font-weight: 500;
        height: 36px;
    }

    .search-btn .search-icon {
        margin-right: 6px;
        font-size: 16px;
    }

    .search-btn:hover {
        background: #1765c1;
        box-shadow: 0 4px 16px rgba(26, 115, 232, 0.13);
    }

    @media (max-width: 800px) {
        .search-bar-inner {
            width: 98vw;
            min-width: 0;
        }
    }

    #engine-name {
        color: #222 !important;
        font-weight: 600;
        font-size: 15px;
        opacity: 1 !important;
        letter-spacing: 0.5px;
    }
</style>

<script>
    // 搜索引擎配置
    const engines = [
        {name: 'Google', url: 'https://www.google.com/search', param: 'q', icon: 'https://www.google.com/favicon.ico'},
        {name: 'Baidu', url: 'https://www.baidu.com/s', param: 'wd', icon: 'https://www.baidu.com/favicon.ico'},
        {name: 'Bing', url: 'https://www.bing.com/search', param: 'q', icon: 'https://www.bing.com/favicon.ico'},
        {
            name: '开发',
            url: 'https://kaifa.baidu.com/searchPage',
            param: 'wd',
            icon: 'https://kaifa.baidu.com/favicon.ico'
        }
    ];

    const selector = document.getElementById('engine-selector');
    const engineList = document.getElementById('engine-list');
    const engineIcon = document.getElementById('engine-icon');
    const engineName = document.getElementById('engine-name');
    const searchInput = document.getElementById('search-input');
    const searchForm = document.getElementById('search-form');

    selector.onclick = function (e) {
        selector.classList.toggle('open');
        e.stopPropagation();
    };
    document.body.onclick = function () {
        selector.classList.remove('open');
    };
    engineList.querySelectorAll('li').forEach(li => {
        li.onclick = function () {
            const url = this.getAttribute('data-url');
            const param = this.getAttribute('data-name');
            const icon = this.getAttribute('data-icon');
            const name = this.textContent.trim();
            searchForm.action = url;
            searchInput.name = param;
            engineIcon.src = icon;
            engineName.textContent = name;
            selector.classList.remove('open');
        };
    });
</script>
