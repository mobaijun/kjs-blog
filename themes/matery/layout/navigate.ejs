<div class="navi-height bg-cover pd-header ">
    <div class="link-box container">
        <!-- 搜索框 -->
        <div class="search-bar-container">
            <form id="search-form" action="https://www.google.com/search" target="_blank" autocomplete="off">
                <div class="search-bar-inner">
                    <div class="search-engine-selector" id="engine-selector">
                        <img id="engine-icon" src="https://www.google.com/favicon.ico" alt="engine"/>
                        <span id="engine-name">Google</span>
                        <svg class="chevron" width="16" height="16" viewBox="0 0 24 24">
                            <path fill="#888" d="M7 10l5 5 5-5z"/>
                        </svg>
                        <ul class="engine-list" id="engine-list">
                            <li data-url="https://www.google.com/search" data-name="q"
                                data-icon="https://www.google.com/favicon.ico">
                                <img src="https://www.google.com/favicon.ico"/>Google
                            </li>
                            <li data-url="https://www.baidu.com/s" data-name="wd"
                                data-icon="https://www.baidu.com/favicon.ico">
                                <img src="https://www.baidu.com/favicon.ico"/>Baidu
                            </li>
                            <li data-url="https://www.bing.com/search" data-name="q"
                                data-icon="https://www.bing.com/favicon.ico">
                                <img src="https://www.bing.com/favicon.ico"/>Bing
                            </li>
                            <li data-url="https://kaifa.baidu.com/searchPage" data-name="wd"
                                data-icon="https://www.baidu.com/favicon.ico">
                                <img src="https://www.baidu.com/favicon.ico"/>开发
                            </li>
                        </ul>
                    </div>
                    <input type="text" id="search-input" name="q" placeholder="请输入搜索内容..." autocomplete="off"/>
                    <button type="submit" class="search-btn">
                        <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24">
                            <path fill="#fff"
                                  d="M9.5 3A6.5 6.5 0 0 1 16 9.5c0 1.61-.59 3.09-1.57 4.23l4.92 4.92a1 1 0 0 1-1.42 1.42l-4.92-4.92A6.5 6.5 0 1 1 9.5 3m0 2A4.5 4.5 0 1 0 14 9.5A4.5 4.5 0 0 0 9.5 5Z"/>
                        </svg>
                        <span>搜索</span>
                    </button>
                </div>
            </form>
        </div>

        <!-- 链接 -->
        <div class="row tags-posts">
            <% if (site.data && site.data.navi) { %>
                <% site.data.navi.forEach(function(category) { %>
                    <div class="col s12 m6 l4 friend-div" data-aos="zoom-in-up">
                        <div class="card">
                            <div class="jj-list-tit"><%= category.title %></div>
                            <ul class="jj-list-con">
                                <% category.links.forEach(function(link) { %>
                                    <li>
                                        <a href="<%= link.url %>" class="link-3" target="_blank"><%= link.text %></a>
                                    </li>
                                <% }); %>
                            </ul>
                        </div>
                    </div>
                <% }); %>
            <% } %>
        </div>
    </div>
</div>

<% if (theme.banner.enable) { %>
    <script>
        // 每天切换 banner 图.  Switch banner image every day.
        var bannerUrl = "<%- theme.jsDelivr.url %><%- url_for(theme.banner.url) %>" + new Date().getDay() + '.jpg';
        $('.bg-cover').css('background-image', 'url(' + bannerUrl + ')');
    </script>
<% } else { %>
    <script>
        $('.bg-cover').css('background-image', 'url(<%- theme.jsDelivr.url %><%- url_for('https://tencent.cos.mobaijun.com/img/banner/0.jpg') %>)');
    </script>
<% } %>

<style>
