</style>
<% if (theme.banner.enable) { %>
    <script>
        // 每天切换 banner 图.  Switch banner image every day.
        $('.bg-cover').css('background-image', 'url(https://cdn.mobaijun.com/qiniu_cdn/img/banner/' + new Date().getDay() + '.jpg)');
